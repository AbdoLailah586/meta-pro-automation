# ==============================================================================
# META PRO MARKETING SUITE — ENVIRONMENT CONFIGURATION
# ==============================================================================

# --- OpenRouter AI Integration (Free Models supported!) ---
# Get your API key for free from: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Default model (can also be selected from UI):
# Free choices: meta-llama/llama-3-8b-instruct:free | google/gemini-2.0-flash-exp:free | deepseek/deepseek-r1:free
DEFAULT_AI_MODEL=meta-llama/llama-3-8b-instruct:free

# --- Meta Graph API (Facebook & Instagram) ---
# Can also be configured directly in the web UI Settings!
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_IG_ACCOUNT_ID=
META_APP_ID=
META_APP_SECRET=

# --- Optional Cloud Database (PostgreSQL / Neon / Supabase) ---
DATABASE_URL=

# --- WhatsApp Pro CRM Live Server Integration ---
WHATSAPP_SERVER_URL=https://whatsapp-pro-crm-production-613b.up.railway.app

# --- Security / Cron Secret for Vercel Cron ---
CRON_SECRET=meta_pro_cron_secret_key
